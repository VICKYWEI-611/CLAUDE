# Copy this file to `.env` and fill in your values. NEVER commit the real .env.

# --- Required: your City of Markham (PerfectMind) account login -------------
PM_EMAIL=you@example.com
PM_PASSWORD=your-password-here

# --- Optional overrides (sensible defaults shown) ---------------------------

# The Aaniin Community Centre drop-in swim calendar page.
# PM_CALENDAR_URL=https://cityofmarkham.perfectmind.com/Clients/BookMe4BookingPages/Classes?calendarId=39bd5c76-e07f-43f3-af24-c6969091dbb4&widgetId=6825ea71-e5b7-4c2a-948f-9195507ad90a&embed=False

# The sessions to book, separated by ";". Each is "Day H:MM AM/PM".
# On each run the script books whichever session's window is open (or opening
# within MAX_WAIT_MINUTES). Default = the three below.
# Optionally give one session its own title keywords with "| words":
#   SESSIONS=Sun 7:45 AM; Tue 8:00 AM | Lane Swim; Fri 8:00 AM
# SESSIONS=Sun 7:45 AM; Tue 8:00 AM; Fri 8:00 AM

# Default words that MUST all appear in a session title (case-insensitive), to
# pick the right program if several run at the same time. Comma-separated.
# Examples: "Lane Swim"  or  "Drop-In,Swim"
# SESSION_KEYWORDS=swim

# The name to tick on the booking form if it shows a list of attendees. Defaults
# to your email's local part; set this to your account holder name for a match.
# PM_ATTENDEE_NAME=Jane Doe

# Booking opens this many hours before the session start. Markham drop-ins
# open 21h before, so a Friday 8:00 AM session opens Thursday 11:00 AM.
# OPEN_HOURS_BEFORE=21

# If the window isn't open yet, wait for it — but only up to this many minutes,
# so a mistimed run doesn't hang. Set FORCE=1 to wait no matter how far off.
# MAX_WAIT_MINUTES=30
# FORCE=1

# At open time, spots can vanish fast: how many times to retry find+book.
# BOOK_RETRIES=6
# BOOK_RETRY_DELAY_MS=2500

# Run without a visible browser window (1) or watch it (0). Default 1.
# HEADLESS=1

# Do everything except the final confirmation click. Great for first tests.
# DRY_RUN=1

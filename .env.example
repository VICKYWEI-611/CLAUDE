# Copy this file to `.env` and fill in your values. NEVER commit the real .env.

# --- Required: your City of Markham (PerfectMind) account login -------------
PM_EMAIL=you@example.com
PM_PASSWORD=your-password-here

# --- Optional overrides (sensible defaults shown) ---------------------------

# The Aaniin Community Centre drop-in swim calendar page.
# PM_CALENDAR_URL=https://cityofmarkham.perfectmind.com/Clients/BookMe4BookingPages/Classes?calendarId=39bd5c76-e07f-43f3-af24-c6969091dbb4&widgetId=6825ea71-e5b7-4c2a-948f-9195507ad90a&embed=False

# Weekday to book: 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
# TARGET_WEEKDAY=5

# Session start time, exactly as shown on the page.
# TARGET_TIME=8:00 AM

# Words that MUST all appear in the session title (case-insensitive), to pick
# the right program if several run at 8 AM. Comma-separated.
# Examples: "Lane Swim"  or  "Drop-In,Swim"
# SESSION_KEYWORDS=swim

# How many days ahead the booking window opens. The script books the furthest
# Friday within this window. Set this to match Markham's actual booking rule.
# DAYS_AHEAD=7

# Run without a visible browser window (1) or watch it (0). Default 1.
# HEADLESS=1

# Do everything except the final confirmation click. Great for first tests.
# DRY_RUN=1
